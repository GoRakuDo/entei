<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the scratch directory the media module writes into is exposed:
         screenshot and audio captures are transient by design, so nothing else
         under the app's cache/files tree is reachable from AnkiDroid. -->
    <cache-path name="anki_media_cache" path="anki_media/" />
</paths>
