{
  "manifestVersion": 1,
  "id": "yomitan",
  "nameKey": "yomitanName",
  "descriptionKey": "yomitanDescription",
  "version": "0.4.0",
  "author": "GoRakuDo",
  "iconPath": "/icons/modules/yomitan.png",
  "tool": {
    "title": "Yomitan Search",
    "description": "Lookup terms, kanji, and sentences in dictionaries",
    "href": "/search/",
    "iconPath": "/icons/modules/yomitan.png"
  },
  "category": "dictionary",
  "builtIn": true,
  "defaultEnabled": true,
  "hasSettings": true,
  "showSectionIcons": true,
  "sectionLayouts": [
    {
      "section": "dictionaries",
      "rows": [
        {
          "layout": "list",
          "field": "dictionaries",
          "source": "yomitan-dictionaries",
          "copy": "dictionaries",
          "label": "Installed Dictionaries",
          "description": "Dictionary entries are managed at runtime. The settings tree exposes per-dictionary fields once a dictionary is installed."
        },
        {
          "layout": "field",
          "field": "global.database.prefixWildcardsSupported",
          "label": "Enable support for prefix wildcard searches"
        },
        {
          "layout": "usage",
          "source": "yomitan-dictionaries",
          "label": "Storage",
          "usage": "Yomitan is using approximately {used} of {total}.",
          "action": "Refresh"
        },
        {
          "layout": "field",
          "field": "general.sortFrequencyDictionary",
          "optionsSource": "yomitan-dictionaries",
          "label": "Frequency sorting dictionary",
          "description": "Sort results using a frequency dictionary.",
          "none": "None"
        },
        {
          "layout": "field",
          "field": "general.sortFrequencyDictionaryOrder",
          "type": "select",
          "label": "Frequency sorting mode",
          "options": [
            { "value": "descending", "label": "Occurrence-based" },
            { "value": "ascending", "label": "Rank-based" }
          ]
        }
      ]
    },
    {
      "section": "scanning",
      "rows": [
        {
          "layout": "field",
          "field": "scanning.modifierKey",
          "type": "select",
          "optionsSource": "yomitan-scan-modifier-keys",
          "label": "Scan modifier key",
          "description": "Hold a key while moving the cursor to scan text."
        },
        {
          "layout": "inputs",
          "field": "scanning.inputs",
          "source": "yomitan-scan-inputs",
          "copy": "scanningInputs",
          "label": "Configure advanced scanning inputs...",
          "description": "Scanning inputs are used to define when text scanning should occur."
        },
        {
          "layout": "field",
          "field": "scanning.delay",
          "label": "Scan delay (in ms)",
          "description": "Change the delay before scanning occurs when no modifier key is required."
        },
        {
          "layout": "field",
          "field": "scanning.scanWithoutMousemove",
          "label": "Scan without mouse move",
          "description": "Allow scanning words under the pointer without the pointer being in motion."
        },
        {
          "layout": "field",
          "field": "scanning.selectText",
          "label": "Select matched text",
          "description": "Highlight the text that was looked up."
        },
        {
          "layout": "field",
          "field": "scanning.layoutAwareScan",
          "label": "Layout-aware scanning",
          "description": "Use webpage styling information to determine where line breaks are likely to be."
        },
        {
          "layout": "field",
          "field": "scanning.deepDomScan",
          "label": "Deep content scanning",
          "description": "Enable scanning text that is covered by other layers."
        },
        {
          "layout": "field",
          "field": "scanning.normalizeCssZoom",
          "label": "Normalize CSS zoom",
          "description": "Correct the pointer location on webpages where CSS zoom is used."
        },
        {
          "layout": "field",
          "field": "scanning.matchTypePrefix",
          "label": "Wildcard scanning",
          "description": "Enable suffix wildcard when looking up scanned webpage text."
        },
        {
          "layout": "field",
          "field": "scanning.length",
          "label": "Text scan length",
          "description": "Change how many characters are read when scanning for terms."
        }
      ]
    },
    {
      "section": "popup-behavior",
      "rows": [
        {
          "layout": "field",
          "field": "scanning.enableOnSearchPage",
          "label": "Allow scanning search page content",
          "description": "Text on the search page can be scanned for definitions, which will open a popup."
        },
        {
          "layout": "field",
          "field": "scanning.enablePopupSearch",
          "label": "Allow scanning popup content",
          "description": "Text inside of popups can be scanned for definitions, which will open a new popup."
        },
        {
          "layout": "field",
          "field": "scanning.popupNestingMaxDepth",
          "label": "Maximum number of child popups",
          "description": "Change the limit on the number of popups that may be generated."
        },
        {
          "layout": "field",
          "field": "scanning.enableOnPopupExpressions",
          "label": "Allow scanning popup source terms"
        },
        {
          "layout": "field",
          "field": "scanning.autoHideResults",
          "label": "Auto-hide search popup",
          "description": "When an existing popup is present, upon scanning again, hide the existing popup even if no definitions are found when scanning again."
        },
        {
          "layout": "field",
          "field": "scanning.hideDelay",
          "label": "Auto-hide Delay (in ms)"
        },
        {
          "layout": "field",
          "field": "scanning.hidePopupOnCursorExit",
          "label": "Hide popup on cursor exit",
          "description": "When the cursor exits the popup, the popup will be hidden."
        },
        {
          "layout": "field",
          "field": "scanning.reducedMotionScrolling",
          "label": "Reduced motion scrolling",
          "description": "Scrolls by a configurable height (similar to pagination), reducing animations. Useful on e-readers and e-ink screens."
        },
        {
          "layout": "field",
          "field": "general.showIframePopupsInRootFrame",
          "label": "Show iframe popups in the root frame"
        }
      ]
    },
    {
      "section": "popup-appearance",
      "rows": [
        {
          "layout": "field",
          "source": "yomitan-popup-preview"
        },
        {
          "layout": "selects",
          "label": "Theme",
          "description": "Adjust the style of Yomitan.",
          "selects": [
            {
              "label": "Body",
              "field": "general.popupTheme",
              "options": [
                { "value": "site", "label": "Auto" },
                { "value": "light", "label": "Light" },
                { "value": "dark", "label": "Dark" },
                { "value": "browser", "label": "Browser" }
              ]
            },
            {
              "label": "Shadow",
              "field": "general.popupOuterTheme",
              "options": [
                { "value": "none", "label": "None" },
                { "value": "site", "label": "Auto" },
                { "value": "light", "label": "Light" },
                { "value": "dark", "label": "Dark" },
                { "value": "browser", "label": "Browser" }
              ]
            }
          ]
        },
        {
          "layout": "selects",
          "label": "Action bar appearance",
          "description": "Control when and where the action bar is visible.",
          "selects": [
            {
              "label": "Visibility",
              "field": "general.popupActionBarVisibility",
              "options": [
                { "value": "auto", "label": "Auto" },
                { "value": "always", "label": "Always" }
              ]
            },
            {
              "label": "Location",
              "field": "general.popupActionBarLocation",
              "options": [
                { "value": "top", "label": "Top" },
                { "value": "bottom", "label": "Bottom" },
                { "value": "left", "label": "Left" },
                { "value": "right", "label": "Right" }
              ]
            }
          ]
        },
        {
          "layout": "field",
          "field": "general.fontFamily",
          "label": "Font family"
        },
        {
          "layout": "field",
          "field": "general.fontSize",
          "label": "Font size (px)"
        },
        {
          "layout": "field",
          "field": "general.lineHeight",
          "label": "Line height"
        },
        {
          "layout": "field",
          "field": "general.glossaryLayoutMode",
          "type": "select",
          "label": "Compact glossaries",
          "description": "Display term glossaries using a more compact layout.",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "compact", "label": "Compact Popup" },
            { "value": "compact-popup-anki", "label": "Compact Popup and Anki" }
          ]
        },
        {
          "layout": "field",
          "field": "general.compactTags",
          "label": "Compact tags",
          "description": "Show fewer repeated tags for term glossaries."
        },
        {
          "layout": "field",
          "field": "scanning.enableSearchTags",
          "label": "Show tags for expressions and their readings",
          "description": "These tags can be scanned if the options for popup content scanning are enabled."
        },
        {
          "layout": "field",
          "field": "general.debugInfo",
          "label": "Show debug information",
          "description": "A menu option to log debugging information will be shown in the search results."
        },
        {
          "layout": "field",
          "field": "general.termDisplayMode",
          "type": "select",
          "label": "Term display style",
          "description": "Change how terms and their readings are displayed.",
          "options": [
            { "value": "ruby", "label": "Term furigana" },
            { "value": "ruby-and-reading", "label": "Term furigana and reading" },
            { "value": "term-and-reading", "label": "Plain term and reading" },
            { "value": "term-only", "label": "Plain term" }
          ]
        },
        {
          "layout": "field",
          "field": "general.frequencyDisplayMode",
          "type": "select",
          "label": "Frequency display style",
          "description": "Change how frequency information is presented.",
          "options": [
            { "value": "tags", "label": "Tags" },
            { "value": "tags-grouped", "label": "Tags, grouped content" },
            { "value": "split-tags", "label": "Split tags" },
            { "value": "split-tags-grouped", "label": "Split tags, grouped content" },
            { "value": "inline-list", "label": "Inline list" },
            { "value": "list", "label": "List" },
            { "value": "list-bordered", "label": "List, bordered" }
          ]
        },
        {
          "layout": "field",
          "field": "general.popupCurrentIndicatorMode",
          "type": "select",
          "label": "Selection indicator style",
          "description": "Change how the selected definition entry is visually indicated.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "asterisk", "label": "Asterisk" },
            { "value": "triangle", "label": "Triangle" },
            { "value": "bar-left", "label": "Vertical bar (left)" },
            { "value": "bar-right", "label": "Vertical bar (right)" },
            { "value": "dot-left", "label": "Small dot (left)" },
            { "value": "dot-right", "label": "Small dot (right)" }
          ]
        },
        {
          "layout": "checkboxes",
          "label": "Pitch accent display styles",
          "description": "Japanese only.",
          "checkboxes": [
            { "label": "Notation", "field": "general.showPitchAccentDownstepNotation" },
            { "label": "Position", "field": "general.showPitchAccentPositionNotation" },
            { "label": "Graph", "field": "general.showPitchAccentGraph" }
          ]
        },
        {
          "layout": "field",
          "field": "general.customPopupCss",
          "label": "Custom popup CSS",
          "description": "CSS injected into the popup."
        }
      ]
    },
    {
      "section": "position-size",
      "rows": [
        {
          "layout": "field",
          "field": "general.popupDisplayMode",
          "type": "select",
          "label": "Display mode",
          "description": "Change the layout of the popup."
        },
        {
          "layout": "field",
          "field": "general.popupFullWidthPosition",
          "type": "select",
          "label": "Popup position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "above-cursor", "label": "Follow Cursor" },
            { "value": "bottom", "label": "Bottom" }
          ]
        },
        {
          "layout": "field",
          "field": "general.popupScalingFactor",
          "type": "select",
          "label": "Scale",
          "description": "Control the scaling factor of the popup.",
          "options": [
            { "value": "0.25", "label": "25%" },
            { "value": "0.33", "label": "33%" },
            { "value": "0.5", "label": "50%" },
            { "value": "0.67", "label": "67%" },
            { "value": "0.75", "label": "75%" },
            { "value": "0.8", "label": "80%" },
            { "value": "0.9", "label": "90%" },
            { "value": "1", "label": "100%" },
            { "value": "1.1", "label": "110%" },
            { "value": "1.25", "label": "125%" },
            { "value": "1.5", "label": "150%" },
            { "value": "1.75", "label": "175%" },
            { "value": "2", "label": "200%" },
            { "value": "2.5", "label": "250%" },
            { "value": "3", "label": "300%" },
            { "value": "4", "label": "400%" },
            { "value": "5", "label": "500%" }
          ]
        },
        {
          "layout": "checkboxes",
          "label": "Auto-scale",
          "checkboxes": [
            { "label": "Zoom level", "field": "general.popupScaleRelativeToPageZoom" },
            { "label": "Viewport", "field": "general.popupScaleRelativeToVisualViewport" }
          ]
        },
        {
          "layout": "numbers",
          "label": "Size",
          "description": "Control the size of the popup, in pixels.",
          "numbers": [
            { "label": "Width", "field": "general.popupWidth" },
            { "label": "Height", "field": "general.popupHeight" }
          ]
        },
        {
          "layout": "field",
          "field": "general.popupHorizontalTextPosition",
          "type": "select",
          "label": "Horizontal text positioning",
          "description": "Change where the popup is positioned relative to horizontal text.",
          "options": [
            { "value": "below", "label": "Below text" },
            { "value": "above", "label": "Above text" }
          ]
        },
        {
          "layout": "field",
          "field": "general.popupVerticalTextPosition",
          "type": "select",
          "label": "Vertical text positioning",
          "description": "Change where the popup is positioned relative to vertical text.",
          "options": [
            { "value": "default", "label": "Same as horizontal text" },
            { "value": "before", "label": "Before reading direction" },
            { "value": "after", "label": "After reading direction" },
            { "value": "left", "label": "Left of text" },
            { "value": "right", "label": "Right of text" }
          ]
        },
        {
          "layout": "numbers",
          "label": "Horizontal text offset",
          "description": "Change the distance the popup is placed relative to horizontal text.",
          "numbers": [
            { "label": "x", "field": "general.popupHorizontalOffset" },
            { "label": "y", "field": "general.popupVerticalOffset" }
          ]
        },
        {
          "layout": "numbers",
          "label": "Vertical text offset",
          "description": "Change the distance the popup is placed relative to vertical text.",
          "numbers": [
            { "label": "x", "field": "general.popupHorizontalOffset2" },
            { "label": "y", "field": "general.popupVerticalOffset2" }
          ]
        }
      ]
    },
    {
      "section": "search-window",
      "description": "Search page behavior and settings.",
      "rows": [
        {
          "layout": "field",
          "field": "general.stickySearchHeader",
          "label": "Sticky search header",
          "description": "Keep the search input header fixed at the top of the search window."
        },
        {
          "layout": "field",
          "field": "general.enableWanakana",
          "label": "Automatic kana conversion",
          "description": "Convert typed romaji to kana (Wanakana)."
        },
        {
          "layout": "field",
          "field": "clipboard.enableSearchPageMonitor",
          "label": "Clipboard monitor",
          "description": "The query on the search page will be automatically updated with text in the clipboard."
        }
      ]
    },
    {
      "section": "parsing",
      "rows": [
        {
          "layout": "field",
          "field": "parsing.termSpacing",
          "label": "Show space between parsed words"
        },
        {
          "layout": "field",
          "field": "parsing.readingMode",
          "type": "select",
          "label": "Reading mode",
          "description": "Change what type of furigana is displayed for parsed text. Japanese only.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "hiragana", "label": "ひらがな" },
            { "value": "katakana", "label": "カタカナ" },
            { "value": "romaji", "label": "Romaji" },
            { "value": "dictionary-reading", "label": "Dictionary reading" }
          ]
        }
      ]
    },
    {
      "section": "result-display",
      "rows": [
        {
          "layout": "field",
          "field": "general.resultOutputMode",
          "label": "Result grouping mode",
          "description": "Change how related results are grouped.",
          "options": [
            { "value": "split", "label": "No grouping" },
            { "value": "group", "label": "Group term-reading pairs" },
            { "value": "term", "label": "Group by term" },
            { "value": "merge", "label": "Group related terms" }
          ]
        },
        {
          "layout": "field",
          "source": "yomitan-related-dictionaries",
          "label": "Group related terms by dictionaries",
          "description": "Dictionaries grouped results are drawn from. The first dictionary you select is the primary one; the others are searched for the same term."
        },
        {
          "layout": "field",
          "field": "general.averageFrequency",
          "label": "Average frequencies",
          "description": "Compress frequency tags into one \"Average\" frequency tag based on the harmonic mean."
        }
      ]
    },
    {
      "section": "audio",
      "rows": [
        {
          "layout": "field",
          "field": "audio.enabled",
          "label": "Enable audio playback for terms",
          "description": "Show a clickable speaker icon next to search results."
        },
        {
          "layout": "field",
          "field": "audio.autoPlay",
          "label": "Auto-play search result audio",
          "description": "The audio for the first result will be played automatically."
        },
        {
          "layout": "field",
          "field": "audio.sources",
          "source": "yomitan-audio-sources",
          "label": "Configure audio playback sources...",
          "description": "When searching for audio, the sources are checked in order until the first valid source is found. This allows for selecting a fallback source if the first choice is not available."
        },
        {
          "layout": "field",
          "field": "audio.fallbackSoundType",
          "type": "select",
          "label": "Audio fallback sound",
          "description": "The sound to play when Yomitan fails to fetch audio.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "click", "label": "Click" },
            { "value": "bloop", "label": "Bloop" }
          ]
        }
      ]
    }
  ]
}