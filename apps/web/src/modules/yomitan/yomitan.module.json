{
  "manifestVersion": 1,
  "id": "yomitan",
  "nameKey": "yomitanName",
  "descriptionKey": "yomitanDescription",
  "version": "0.3.0",
  "author": "GoRakuDo",
  "iconPath": "/icons/modules/yomitan.png",
  "category": "dictionary",
  "builtIn": true,
  "defaultEnabled": true,
  "hasSettings": true,
  "showSectionIcons": true,
  "sectionLayouts": [
    {
      "section": "dictionaries",
      "copy": "dictionaries",
      "rows": [
        {
          "layout": "list",
          "field": "dictionaries",
          "source": "yomitan-dictionaries",
          "labelKey": "installedTitle",
          "descriptionKey": "installedDescription"
        },
        {
          "layout": "field",
          "field": "global.database.prefixWildcardsSupported",
          "labelKey": "prefixWildcards"
        },
        {
          "layout": "usage",
          "source": "yomitan-dictionaries",
          "labelKey": "storage",
          "usageKey": "storageUsage",
          "actionKey": "refresh"
        },
        {
          "layout": "field",
          "field": "general.sortFrequencyDictionary",
          "optionsSource": "yomitan-dictionaries",
          "labelKey": "sortFrequency",
          "descriptionKey": "sortFrequencyDescription",
          "noneKey": "sortFrequencyNone"
        }
      ]
    },
    {
      "section": "scanning",
      "copy": "scanning",
      "rows": [
        {
          "layout": "field",
          "field": "scanning.modifierKey",
          "type": "select",
          "optionsSource": "yomitan-scan-modifier-keys",
          "labelKey": "modifierKey",
          "descriptionKey": "modifierKeyDescription"
        },
        {
          "layout": "inputs",
          "field": "scanning.inputs",
          "source": "yomitan-scan-inputs",
          "labelKey": "advancedInputs",
          "descriptionKey": "advancedInputsDescription"
        },
        {
          "layout": "field",
          "field": "scanning.delay",
          "labelKey": "delay",
          "descriptionKey": "delayDescription"
        },
        {
          "layout": "field",
          "field": "scanning.scanWithoutMousemove",
          "labelKey": "scanWithoutMousemove",
          "descriptionKey": "scanWithoutMousemoveDescription"
        },
        {
          "layout": "field",
          "field": "scanning.selectText",
          "labelKey": "selectText",
          "descriptionKey": "selectTextDescription"
        },
        {
          "layout": "field",
          "field": "scanning.deepDomScan",
          "labelKey": "deepDomScan",
          "descriptionKey": "deepDomScanDescription"
        },
        {
          "layout": "field",
          "field": "scanning.normalizeCssZoom",
          "labelKey": "normalizeCssZoom",
          "descriptionKey": "normalizeCssZoomDescription"
        },
        {
          "layout": "field",
          "field": "scanning.matchTypePrefix",
          "labelKey": "wildcardScanning",
          "descriptionKey": "wildcardScanningDescription"
        },
        {
          "layout": "field",
          "field": "scanning.length",
          "labelKey": "length",
          "descriptionKey": "lengthDescription"
        }
      ]
    }
  ]
}