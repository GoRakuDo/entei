---
/**
 * Hub Emblem — user-provided Entei brand mark.
 * The source artwork is stored as /brand/emblem.svg for favicon and UI reuse.
 *
 * `aria-hidden="true"` because the wordmark (live text) carries the name.
 */
interface Props {
  class?: string;
}

const { class: className = 'entei-emblem' } = Astro.props;
---

<img
  class={className}
  src="/brand/emblem.svg"
  width="28"
  height="28"
  alt=""
  aria-hidden="true"
/>

<style>
  .entei-emblem {
    display: block;
    flex-shrink: 0;
  }
</style>
