---
/**
 * Top Bar — NAVIGATION_BAR.md full desktop redesign (Stage N1+2).
 *
 * Architecture per NAVIGATION_BAR.md §3, §4:
 *
 * Desktop (≥768px):
 * - NO sticky black TopBar strip (removed per spec).
 * - Home: SNS-style pinned LEFT SIDEBAR (brand, Home, Profile,
 *   Immersion Tools drawer, Settings). The timeline keeps the centered
 *   column, giving a modern 2-column layout. See `eizouden-settings.css`
 *   for the sidebar rules.
 * - Profile: always-visible pill in normal document flow (scrolls out).
 *   Pill = [HubEmblem + "Entei" (Home link) | Profile | Immersion Tools].
 * - Player: pill hidden by default. Top-edge hover zone and keyboard focus
 *   reveal it, shared containment, 200ms dismiss delay.
 * - Language selection lives in the Settings modal (the desktop topbar no
 *   longer carries a language combobox).
 *
 * MODULE_ARCHITECTURE.md §4: the former direct "Player" destination is now
 * the Immersion Tools drawer (ImmersionToolsDialog island), which opens
 * /player/, /audio-player/ and /modules/ from one shelf.
 *
 * Mobile (<768px):
 * - Sticky header with brand + optional native LanguageSelector — hidden
 *   entirely on Home (the dock is the only chrome there). Leaf surfaces
 *   (/modules/, /player/) replace both with a single "← Kembali" back control.
 * - Floating bottom Dock: Home / Immersion Tools / Settings.
 *   DOM-ordered from MOBILE_DESTINATIONS + the dialog entries.
 *
 * Wordmark uses Pixelify Sans (font-system) for a consistent game-accent
 * feel across all pages.
 */
import HubEmblem from '@components/icons/HubEmblem.astro';
import LanguageSelector from '@components/LanguageSelector.astro';
import { EizouSettingsDialog } from '@components/home/EizouSettingsDialog';
import { ImmersionToolsDialog } from '@components/home/ImmersionToolsDialog';
import { ArrowLeft, House, User } from '@lucide/astro';

/** Destination definitions — desktop pill and mobile dock each read from their own array. */
const DESKTOP_DESTINATIONS = [
  {
    route: '/profile/',
    labelKey: 'destinationProfile' as const,
    Icon: User,
  },
] as const;

/**
 * Desktop Home sidebar destinations (SNS-style left rail).
 * DOM order Home → Profile; the Immersion Tools drawer and Settings follow as
 * React islands. The brand row above the list links to `/` but carries no
 * aria-current — the Home row owns the active state.
 */
const SIDEBAR_DESTINATIONS = [
  { route: '/', labelKey: 'destinationHome' as const, Icon: House },
  {
    route: '/profile/',
    labelKey: 'destinationProfile' as const,
    Icon: User,
  },
] as const;

/**
 * Mobile dock destinations: Home only. The Immersion Tools drawer and the
 * Settings dialog entries follow as islands.
 */
const MOBILE_DESTINATIONS = [
  { route: '/', labelKey: 'destinationHome' as const, Icon: House },
] as const;

const {
  locale,
  dictionary,
  showLanguageSelector = true,
  currentPath = '/',
  /** Treat this route like the video player (hover-reveal desktop pill zone). */
  isPlayer: playerLike = false,
} = Astro.props;

/**
 * Normalise currentPath: strip trailing slash except for root '/',
 * so '/player/' matches '/player' and '/' stays '/'.
 */
function normalisePath(p: string): string {
  if (p === '/') return '/';
  return p.endsWith('/') ? p.slice(0, -1) : p;
}
const activePath = normalisePath(currentPath);
/** The real /player/ route: player.css hides its mobile chrome once media
 *  loads, so the entry screen still shows the TopBar. */
const isVideoPlayer = activePath === '/player';
/**
 * Player-style chrome (the hover-reveal desktop pill zone). True for the
 * video player route and for any route that opts in via `isPlayer` — the
 * audio player does, but keeps its mobile top bar until a track loads.
 */
const isPlayer = isVideoPlayer || playerLike;
/**
 * Home (`/`) uses the desktop left sidebar instead of the floating pill, and
 * hides the mobile sticky header entirely (the dock is the only mobile chrome).
 */
const isHome = activePath === '/';
/**
 * Leaf surfaces opened from the Immersion Tools drawer swap the mobile TopBar
 * brand + language selector for a single "← Kembali" back control: going back
 * is the only useful action there and language lives in the Settings modal.
 * `/player/` joins `/modules/` (and its subpages): on a phone the video
 * player entry screen needs the same back affordance instead of the wordmark.
 * Both reuse modulesPage.back, present in id/ja/en as Kembali / 戻る / Back
 * and resolved by the locale switcher through data-i18n.
 */
const isModules = activePath === '/modules' || activePath.startsWith('/modules/');
const isMobileBack = isModules || isVideoPlayer;

/**
 * Full serializable playerUI dictionary for the global settings dialog
 * (both the desktop pill entry and the mobile Dock entry share this —
 * DRY). playerUI is all strings, so it crosses the island boundary as
 * JSON. The dialog uses settingsTitleGlobal ("Settings") rather than the
 * player-scoped settingsTitle ("Player Settings"), since it opens from
 * any page.
 */
const settingsUIProps = dictionary.playerUI;
---

<!--
  ============================================================
  MOBILE: sticky header with brand + optional LanguageSelector
  Hidden on desktop via CSS (display:none ≥768px).
  Rendered on every route including the video player: PlayerApp marks
  <html> with `entei-video-loaded` once media loads and player.css hides
  this header on <768px, so entry (file select) shows chrome and playback
  hides it. The DOM stays mounted for SEO and app-shell stability.
  On the audio player the AudioPlayer wrapper marks the document with
  `entei-audio-loaded` once a track loads; AudioPlayer.css hides this header
  while keeping the DOM mounted for SEO and app-shell stability.
  Home (/) does NOT render this header at all: the mobile Home surface is the
  dock-only SNS feed (the language selector moved into the Settings modal).
  ============================================================
-->
{
  !isHome && (
    <header class="entei-topbar-mobile" role="banner">
      <div class="entei-topbar-mobile-inner">
        {isMobileBack ? (
          <a
            class="entei-mobile-back"
            href="/"
            aria-label={dictionary.modulesPage.back}
          >
            <ArrowLeft class="entei-mobile-back-icon" aria-hidden="true" />
            <span data-i18n="modulesPage.back">{dictionary.modulesPage.back}</span>
          </a>
        ) : (
          <a class="entei-wordmark" href="/">
            <HubEmblem class="entei-wordmark-emblem" />
            <span class="entei-wordmark-text">Entei</span>
          </a>
        )}
        {showLanguageSelector && !isMobileBack && (
          <LanguageSelector
            currentLocale={locale}
            selectLabel={dictionary.language.selectLabel}
          />
        )}
      </div>
    </header>
  )
}

<!--
  ============================================================
  DESKTOP HOME: pinned left sidebar (SNS-style navigation)
  Hidden on mobile via CSS (display:none <768px).
  Brand → Home → Profile → Immersion Tools → Settings.
  The fixed sidebar reserves its width on the left edge of #entei-main
  (see eizouden-settings.css), so the timeline stays in the center column.
  ============================================================
-->
{
  isHome && (
    <aside class="entei-desktop-sidebar" data-entei-desktop-sidebar>
      <nav
        class="entei-desktop-sidebar-nav"
        aria-label={dictionary.nav.desktopNavLabel}
        data-entei-desktop-nav
        data-i18n-aria-label="nav.desktopNavLabel"
      >
        <a
          class="entei-desktop-sidebar-brand"
          href="/"
          data-entei-nav-destination="/"
        >
          <HubEmblem class="entei-desktop-sidebar-brand-emblem" />
          <span class="entei-desktop-sidebar-brand-text">Entei</span>
        </a>
        <ul class="entei-desktop-sidebar-list">
          {SIDEBAR_DESTINATIONS.map(({ route, labelKey, Icon }) => {
            const isActive = normalisePath(route) === activePath;
            return (
              <li class="entei-desktop-sidebar-item">
                <a
                  class="entei-desktop-sidebar-link"
                  href={route}
                  aria-current={isActive ? 'page' : undefined}
                  data-entei-nav-destination={route}
                >
                  <Icon class="entei-desktop-sidebar-icon" aria-hidden="true" />
                  <span data-i18n={`nav.${labelKey}`}>
                    {dictionary.nav[labelKey]}
                  </span>
                </a>
              </li>
            );
          })}
          <li class="entei-desktop-sidebar-item">
            <ImmersionToolsDialog
              client:load
              label={dictionary.nav.destinationTools}
              variant="sidebar"
              dict={dictionary.toolsDrawer}
              currentPath={activePath}
            />
          </li>
          <li class="entei-desktop-sidebar-item">
            <EizouSettingsDialog
              client:load
              label={dictionary.nav.destinationSettings}
              triggerLabel={dictionary.playerUI.settingsLabel}
              variant="sidebar"
              playerUI={settingsUIProps}
              showShortcuts={isPlayer}
              nadeshikoDict={dictionary.nadeshiko}
              locale={locale}
              languageLabel={dictionary.language.selectLabel}
            />
          </li>
        </ul>
      </nav>
    </aside>
  )
}

<!--
  ============================================================
  DESKTOP (non-Home): pill zone
  Hidden on mobile via CSS (display:none <768px).

  Profile (.entei-desktop-pill-zone):
    Normal document flow, centered pill, always visible.

  Player (.entei-desktop-pill-zone--player):
    Fixed at viewport top. Pill hidden by default.
    Revealed on hover (fine pointer) and keyboard focus-within.
    Shared containment, 200ms dismiss delay.

  The desktop language combobox was removed: language now lives in the
  Settings modal (EizouSettingsDialog → language row).
  ============================================================
-->
{
  !isHome && (
    <div
      class:list={[
        'entei-desktop-pill-zone',
        { 'entei-desktop-pill-zone--player': isPlayer },
      ]}
      data-entei-desktop-nav-zone
    >
      {isPlayer && (
        <div class="entei-desktop-pill-trigger-zone" data-entei-trigger-zone />
      )}
      <nav
        class="entei-desktop-pill"
        aria-label={dictionary.nav.desktopNavLabel}
        data-entei-desktop-nav
        data-i18n-aria-label="nav.desktopNavLabel"
      >
        <!-- Brand = Home link (NAVIGATION_BAR.md: brandはpillの最初のHome link) -->
        <a
          class="entei-desktop-pill-brand"
          href="/"
          aria-current={activePath === '/' ? 'page' : undefined}
          data-entei-nav-destination="/"
        >
          <HubEmblem class="entei-desktop-pill-icon" />
          <span>Entei</span>
        </a>
        {
          DESKTOP_DESTINATIONS.map(({ route, labelKey, Icon }) => {
            const isActive = normalisePath(route) === activePath;
            return (
              <a
                class="entei-desktop-pill-link"
                href={route}
                aria-current={isActive ? 'page' : undefined}
                data-entei-nav-destination={route}
              >
                <Icon class="entei-desktop-pill-icon" aria-hidden="true" />
                <span data-i18n={`nav.${labelKey}`}>
                  {dictionary.nav[labelKey]}
                </span>
              </a>
            );
          })
        }
        {
          (
            /* Immersion Tools drawer — replaces the former direct Player link
             (MODULE_ARCHITECTURE.md §4). */
            <ImmersionToolsDialog
              client:load
              label={dictionary.nav.destinationTools}
              variant="pill"
              dict={dictionary.toolsDrawer}
              currentPath={activePath}
            />
          )
        }
        {
          (
            /* Settings button — opens the EizouDen settings modal from any page
             (NAVIGATION_BAR.md 2026-08-07). Not a route. */
            <EizouSettingsDialog
              client:load
              label={dictionary.nav.destinationSettings}
              triggerLabel={dictionary.playerUI.settingsLabel}
              variant="pill"
              playerUI={settingsUIProps}
              showShortcuts={isPlayer}
              nadeshikoDict={dictionary.nadeshiko}
              locale={locale}
              languageLabel={dictionary.language.selectLabel}
            />
          )
        }
      </nav>
    </div>
  )
}

<!--
  ============================================================
  MOBILE: floating bottom Dock — all routes.
  Hidden on desktop via CSS (display:none ≥768px).
  ============================================================
-->
<nav
  class="entei-mobile-dock"
  aria-label={dictionary.nav.mobileDockLabel}
  data-entei-mobile-dock
  data-i18n-aria-label="nav.mobileDockLabel"
  data-entei-mobile-dock-scroll-only={isHome ? '' : undefined}
>
  {
    MOBILE_DESTINATIONS.map(({ route, labelKey, Icon }) => {
      const isActive = normalisePath(route) === activePath;
      return (
        <a
          class="entei-mobile-dock-link"
          href={route}
          aria-current={isActive ? 'page' : undefined}
          aria-label={dictionary.nav[labelKey]}
          data-i18n-aria-label={`nav.${labelKey}`}
          data-entei-nav-destination={route}
        >
          <Icon class="entei-mobile-dock-icon" aria-hidden="true" />
          <span class="entei-mobile-dock-label" data-i18n={`nav.${labelKey}`}>
            {dictionary.nav[labelKey]}
          </span>
        </a>
      );
    })
  }
  {
    (
      /* Immersion Tools drawer — the mobile dock's middle entry
       (MODULE_ARCHITECTURE.md §4.1). */
      <ImmersionToolsDialog
        client:load
        label={dictionary.nav.destinationTools}
        variant="dock"
        dict={dictionary.toolsDrawer}
        currentPath={activePath}
      />
    )
  }
  {
    (
      /* Settings — mobile Dock entry (NAVIGATION_BAR.md 2026-08-07). */
      <EizouSettingsDialog
        client:load
        label={dictionary.nav.destinationSettings}
        triggerLabel={dictionary.playerUI.settingsLabel}
        variant="dock"
        playerUI={settingsUIProps}
        showShortcuts={isPlayer}
        nadeshikoDict={dictionary.nadeshiko}
        locale={locale}
        languageLabel={dictionary.language.selectLabel}
      />
    )
  }
</nav>

<style>
  /* ===========================================================================
   * MOBILE STICKY HEADER — <768px only
   * =========================================================================== */
  .entei-topbar-mobile {
    position: sticky;
    top: 0;
    z-index: var(--entei-z-topbar);
    background-color: transparent;
  }

  @media (forced-colors: active) {
    .entei-topbar-mobile {
      background-color: Canvas;
      border-bottom: 1px solid ButtonText;
    }
  }

  .entei-topbar-mobile-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--entei-space-16);
    min-height: var(--entei-topbar-height);
    padding: calc(var(--entei-safe-top) + var(--entei-space-8))
      var(--entei-gutter) var(--entei-space-8);
    max-width: var(--entei-content-max);
    margin-inline: auto;
  }

  @media (max-width: 360px) {
    .entei-topbar-mobile-inner {
      flex-wrap: wrap;
      gap: var(--entei-space-8);
    }
  }

  /* Hide mobile header on desktop */
  @media (min-width: 768px) {
    .entei-topbar-mobile {
      display: none;
    }
  }

  /* Wordmark */
  .entei-wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--entei-space-12);
    min-height: var(--entei-touch-min);
    padding: var(--entei-space-8) 0;
    color: var(--entei-text);
    font-family: var(--entei-font-system);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .entei-wordmark:hover {
    color: var(--entei-text);
  }

  .entei-wordmark-emblem {
    width: 28px;
    height: 28px;
  }

  .entei-wordmark-text {
    line-height: 1;
  }

  /* Mobile back control (/modules/ + /player/): replaces brand + language selector. */
  .entei-mobile-back {
    display: inline-flex;
    align-items: center;
    gap: var(--entei-space-8);
    min-height: var(--entei-touch-min);
    padding: var(--entei-space-8) 0;
    color: var(--entei-text);
    font-family: var(--entei-font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .entei-mobile-back:hover {
    color: var(--entei-accent-hover);
  }

  .entei-mobile-back-icon {
    width: 20px;
    height: 20px;
  }

  /* ===========================================================================
   * DESKTOP PILL ZONE — ≥768px only
   * Contains: pill (centered) + Combobox (right edge).
   * =========================================================================== */

  /* Hide pill zone on mobile */
  @media (max-width: 767px) {
    .entei-desktop-pill-zone {
      display: none;
    }
  }

  /* --- Home / Profile: normal flow, always visible --- */
  @media (min-width: 768px) {
    .entei-desktop-pill-zone {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      width: 100%;
      padding: var(--entei-space-16) 0 var(--entei-space-4) 0;
    }

    /* Pill — centered horizontal nav */
    .entei-desktop-pill {
      display: flex;
      align-items: center;
      gap: var(--entei-space-8);
      padding: var(--entei-space-4) var(--entei-space-8);
      background-color: var(--entei-surface);
      border: 1px solid oklch(100% 0 0deg / 0.08);
      border-radius: var(--entei-radius-pill);
      box-shadow:
        0 4px 6px -1px oklch(0% 0 0deg / 0.15),
        0 2px 4px -2px oklch(0% 0 0deg / 0.1);
    }

    /* Brand = first Home link */
    .entei-desktop-pill-brand {
      display: inline-flex;
      align-items: center;
      gap: var(--entei-space-8);
      min-height: var(--entei-touch-min);
      padding: var(--entei-space-4) var(--entei-space-8);
      color: var(--entei-text);
      font-family: var(--entei-font-system);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
      border-radius: var(--entei-radius-card);
      transition: color var(--entei-duration-fast) var(--entei-ease-productive);
    }

    /* brand hover: no visual change (text + SVG color stay).
       color: inherit overrides the global a:hover accent tint. */
    .entei-desktop-pill-brand:hover {
      color: inherit;
    }

    .entei-desktop-pill-brand:focus-visible {
      outline: 3px solid var(--entei-focus-ring);
      outline-offset: 2px;
      color: var(--entei-text);
    }

    /* Brand text stays white (matches SVG emblem) — no accent purple override */

    /* Destination links (Profile, Player) */
    .entei-desktop-pill-link {
      display: inline-flex;
      align-items: center;
      gap: var(--entei-space-8);
      min-height: var(--entei-touch-min);
      padding: var(--entei-space-4) var(--entei-space-12);
      background-color: transparent;
      color: var(--entei-text-secondary);
      font-family: var(--entei-font-body);
      font-weight: 500;
      border-radius: var(--entei-radius-card);
      text-decoration: none;
      transition:
        color var(--entei-duration-fast) var(--entei-ease-productive),
        background-color var(--entei-duration-fast) var(--entei-ease-productive);
    }

    .entei-desktop-pill-link:hover {
      color: inherit; /* keep text + SVG color on hover (no global a:hover tint) */
      background-color: var(--entei-btn-color);
      border-radius: var(--entei-radius-pill);
    }

    .entei-desktop-pill-link:focus-visible {
      outline: 3px solid var(--entei-focus-ring);
      outline-offset: 2px;
      color: var(--entei-text);
    }

    .entei-desktop-pill-link[aria-current='page'] {
      color: var(--entei-status-locked);
      font-weight: 600;
      background-color: var(--entei-btn-color);
      border-radius: var(--entei-radius-card);
    }

    .entei-desktop-pill-link[aria-current='page'] .entei-desktop-pill-icon {
      color: var(--entei-status-locked);
    }

    .entei-desktop-pill-link[aria-current='page']:hover {
      color: var(--entei-status-locked);
    }

    /* Icon sizing — stroke-width matches the 600-weight active label. */
    .entei-desktop-pill-icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      stroke-width: 2.5;
    }

    /* Combobox — REMOVED (2026-08-27): the desktop language selector now
       lives inside the Settings modal, not the topbar. */

    /* Forced colors */
    @media (forced-colors: active) {
      .entei-desktop-pill {
        background-color: Canvas;
        border-color: ButtonText;
      }
      .entei-desktop-pill-brand,
      .entei-desktop-pill-link {
        color: LinkText;
      }
      .entei-desktop-pill-brand:hover,
      .entei-desktop-pill-link:hover,
      .entei-desktop-pill-brand:focus-visible,
      .entei-desktop-pill-link:focus-visible {
        background-color: Highlight;
        color: HighlightText;
      }
      .entei-desktop-pill-brand[aria-current='page'],
      .entei-desktop-pill-link[aria-current='page'] {
        background-color: Highlight;
        color: HighlightText;
      }
      .entei-desktop-pill-brand:focus-visible,
      .entei-desktop-pill-link:focus-visible {
        outline-color: HighlightText;
      }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .entei-desktop-pill-brand,
      .entei-desktop-pill-link {
        transition: none;
      }
    }
  }

  /* ===========================================================================
   * DESKTOP PLAYER — pill hidden, revealed on hover / focus
   * ---------------------------------------------------------------------------
   * - Fixed at viewport top (above media content).
   * - Hover reveal: a transparent trigger-zone child (360px centered) receives
   *   pointer events while the outer zone stays pointer-events:none (so it
   *   never blocks wordmark / controls outside its region). :hover propagates
   *   from the trigger-zone child to the parent zone via DOM tree.
   *   Pointer must dwell 750ms continuously before pill reveals.
   *   Shared containment ensures pointer travel from trigger
   *   to pill never dismisses.
   * - Keyboard reveal: focus-within on the zone (immediate, no dwell delay).
   * - Dismiss: 200ms delay on pointer leave.
   * - Closed state: opacity + transform + pointer-events on children only
   *   (no display:none, no visibility:hidden, no inert, no aria-hidden) —
   *   tab order preserved.
   * =========================================================================== */
  @media (min-width: 768px) {
    .entei-desktop-pill-zone--player {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: var(--entei-z-topbar);
      justify-content: center;
      padding-top: var(--entei-space-16);
      /* Outer zone is pointer-events:none so it never blocks anything
         outside its region. The inner trigger-zone child handles hover. */
      pointer-events: none;
    }

    /* Transparent trigger zone: 360px centered at top edge.
       Receives pointer events → :hover propagates to parent zone via DOM. */
    .entei-desktop-pill-trigger-zone {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 360px;
      height: var(--entei-topbar-height);
      pointer-events: auto;
      /* No visual styling — invisible hover target */
    }

    /* Children hidden by default.
       200ms dismiss delay on leaving containment. */
    .entei-desktop-pill-zone--player .entei-desktop-pill {
      opacity: 0;
      transform: translateY(calc(var(--entei-space-2) * -1));
      pointer-events: none;
      transition:
        opacity var(--entei-duration-normal) var(--entei-ease-productive) 200ms,
        transform var(--entei-duration-normal) var(--entei-ease-productive)
          200ms;
    }

    /* Hover reveal (fine pointer devices only).
        Pointer must dwell for 750ms before reveal begins.
       :hover propagates from trigger-zone child to parent zone. */
    @media (hover: hover) and (pointer: fine) {
      .entei-desktop-pill-zone--player:hover .entei-desktop-pill {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
        /* 750ms dwell delay, then reveal (var(--entei-duration-normal)) */
        transition:
          opacity var(--entei-duration-normal) var(--entei-ease-productive)
            750ms,
          transform var(--entei-duration-normal) var(--entei-ease-productive)
            750ms;
      }
    }

    /* Keyboard focus-within reveal */
    .entei-desktop-pill-zone--player:focus-within .entei-desktop-pill {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
      /* Revealed state: no delay */
      transition:
        opacity var(--entei-duration-normal) var(--entei-ease-productive),
        transform var(--entei-duration-normal) var(--entei-ease-productive);
    }

    /* Reduced motion: no transform offset */
    @media (prefers-reduced-motion: reduce) {
      .entei-desktop-pill-zone--player .entei-desktop-pill {
        transform: none;
      }
      .entei-desktop-pill-zone--player:hover .entei-desktop-pill,
      .entei-desktop-pill-zone--player:focus-within .entei-desktop-pill {
        transform: none;
      }
    }
  }

  /* ===========================================================================
   * MOBILE FLOATING DOCK — <768px only
   * =========================================================================== */
  @media (max-width: 767px) {
    .entei-mobile-dock {
      position: fixed;
      bottom: calc(var(--entei-safe-bottom) + var(--entei-space-16));
      left: 50%;
      transform: translateX(-50%);
      width: fit-content;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--entei-space-12);
      padding: var(--entei-space-4);
      background-color: oklch(14% 0.02 270deg / 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid oklch(100% 0 0deg / 0.12);
      border-radius: var(--entei-radius-pill);
      box-shadow:
        0 8px 24px -4px oklch(0% 0 0deg / 0.4),
        0 2px 6px -1px oklch(0% 0 0deg / 0.2);
      z-index: calc(var(--entei-z-topbar) + 10);
      opacity: 1;
      visibility: visible;
      transition:
        opacity var(--entei-duration-normal) var(--entei-ease-productive),
        transform var(--entei-duration-normal) var(--entei-ease-productive),
        visibility var(--entei-duration-normal) var(--entei-ease-productive);
    }

    /* Auto-hide state: slide down and fade out when scrolling down or idle 6s.
       Uses :global() so Astro's scoped CSS compiler does not tree-shake the
       dynamically added data-hidden attribute. */
    :global(.entei-mobile-dock[data-hidden='true']) {
      opacity: 0 !important;
      visibility: hidden !important;
      transform: translate(-50%, calc(100% + var(--entei-space-24))) !important;
      pointer-events: none !important;
    }

    /* Force visible while any control inside the dock holds focus */
    .entei-mobile-dock:focus-within {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateX(-50%) !important;
      pointer-events: auto !important;
    }

    .entei-mobile-dock-link {
      width: 64px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      color: var(--entei-text-secondary);
      text-decoration: none;
      border: 1px solid transparent;
      border-radius: var(--entei-radius-pill);
      transition:
        color var(--entei-duration-fast) var(--entei-ease-productive),
        background-color var(--entei-duration-fast) var(--entei-ease-productive),
        border-color var(--entei-duration-fast) var(--entei-ease-productive);
    }

    /* Hide text label on mobile — icons only per design */
    .entei-mobile-dock-label {
      display: none;
    }

    .entei-mobile-dock-link:hover {
      color: var(--entei-text);
      background-color: var(--entei-surface-2);
    }

    .entei-mobile-dock-link:focus-visible {
      outline: 3px solid var(--entei-focus-ring);
      outline-offset: 2px;
      color: var(--entei-text);
      background-color: var(--entei-surface-2);
    }

    .entei-mobile-dock-link:active {
      background-color: oklch(100% 0 0deg / 0.06);
    }

    /* Active page state — highlighted pill per design mock */
    .entei-mobile-dock-link[aria-current='page'] {
      color: var(--entei-status-locked);
      background-color: oklch(57.74% 0.209 273.85deg / 0.16);
      border-color: oklch(100% 0 0deg / 0.12);
    }

    .entei-mobile-dock-link[aria-current='page'] .entei-mobile-dock-icon {
      color: var(--entei-status-locked);
    }

    .entei-mobile-dock-link[aria-current='page']:hover {
      color: var(--entei-status-locked);
      background-color: oklch(57.74% 0.209 273.85deg / 0.18);
    }

    /* Icon sizing */
    .entei-mobile-dock-icon {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .entei-mobile-dock {
        transition: opacity var(--entei-duration-fast) linear;
      }
      :global(.entei-mobile-dock[data-hidden='true']) {
        transform: translateX(-50%) !important;
      }
      .entei-mobile-dock-link {
        transition: none;
      }
    }

    /* Forced colors */
    @media (forced-colors: active) {
      .entei-mobile-dock {
        background-color: Canvas;
        border-color: ButtonText;
      }
      .entei-mobile-dock-link {
        color: LinkText;
      }
      .entei-mobile-dock-link:hover,
      .entei-mobile-dock-link:focus-visible {
        background-color: Highlight;
        color: HighlightText;
      }
      .entei-mobile-dock-link[aria-current='page'] {
        background-color: Highlight;
        color: HighlightText;
      }
      .entei-mobile-dock-link:focus-visible {
        outline-color: HighlightText;
      }
    }
  }

  /* Hide mobile dock on desktop */
  @media (min-width: 768px) {
    .entei-mobile-dock {
      display: none;
    }
  }
</style>

<script>
  /**
   * Mobile floating dock auto-hide behavior:
   * - On load: shown.
   * - Scrolling down: hides immediately.
   * - Scrolling up: reveals immediately and starts the 6-second idle timer.
   * - At/near top of page (<=10px): stays revealed with the 6-second timer.
   * - Direct dock interaction (touch, focus): keeps it revealed.
   * - Keyboard focus inside dock: stays revealed; idle timer restarts
   *   once focus leaves the dock.
   * - Scroll-only mode (`data-entei-mobile-dock-scroll-only`, set on Home):
   *   NO idle timer at all — the dock is visible by default and only
   *   scroll direction changes its state (Home has no mobile top bar, so an
   *   idle auto-hide would leave the page with no chrome at all).
   * - Scroll events are coalesced via requestAnimationFrame to avoid
   *   layout thrashing on high-frequency scroll bursts.
   */
  function initMobileDockAutoHide() {
    const dock = document.querySelector<HTMLElement>('.entei-mobile-dock');
    if (!dock || dock.dataset.autoHideBound) return;
    dock.dataset.autoHideBound = 'true';

    /** Home: scroll direction only, never an idle fade-out. */
    const scrollOnly = dock.hasAttribute('data-entei-mobile-dock-scroll-only');
    const AUTO_HIDE_DELAY_MS = 6000;
    const SCROLL_DELTA_THRESHOLD_PX = 6;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    let lastScrollY = window.scrollY;

    function isFocusInsideDock(): boolean {
      return dock?.contains(document.activeElement) ?? false;
    }

    function showDock() {
      dock?.removeAttribute('data-hidden');
    }

    function hideDock() {
      if (isFocusInsideDock()) return;
      dock?.setAttribute('data-hidden', 'true');
    }

    function resetHideTimer() {
      if (hideTimer !== null) {
        clearTimeout(hideTimer);
      }
      // Home (scroll-only) never auto-hides while idle.
      if (scrollOnly) {
        hideTimer = null;
        return;
      }
      hideTimer = setTimeout(hideDock, AUTO_HIDE_DELAY_MS);
    }

    // Initial state: visible on page load, auto-hides after 6s idle
    showDock();
    resetHideTimer();

    function handleScroll() {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;

      // Near top of page: always show and start idle timer
      if (currentScrollY <= 10) {
        showDock();
        resetHideTimer();
        lastScrollY = currentScrollY;
        return;
      }

      // Ignore minor scroll jitter (under threshold)
      if (Math.abs(delta) < SCROLL_DELTA_THRESHOLD_PX) {
        return;
      }

      if (delta > 0) {
        // Scrolling down: hide immediately, cancel idle timer
        if (hideTimer !== null) {
          clearTimeout(hideTimer);
          hideTimer = null;
        }
        hideDock();
      } else {
        // Scrolling up: reveal immediately, start 6s idle timer
        showDock();
        resetHideTimer();
      }

      lastScrollY = currentScrollY;
    }

    // rAF-coalesce scroll events: high-frequency scroll otherwise triggers
    // layout-thrashing work on every frame; coalesce to one read per paint.
    let scrollFrameQueued = false;
    function onScrollRaf() {
      scrollFrameQueued = false;
      handleScroll();
    }
    function queuedHandleScroll() {
      if (scrollFrameQueued) return;
      scrollFrameQueued = true;
      window.requestAnimationFrame(onScrollRaf);
    }

    // Keep active when touching the dock
    dock.addEventListener(
      'touchstart',
      () => {
        if (hideTimer !== null) clearTimeout(hideTimer);
        showDock();
      },
      { passive: true },
    );
    dock.addEventListener('touchend', resetHideTimer, { passive: true });

    // Keep dock revealed while keyboard focus is inside it (e.g. user tabs
    // through dock links); restart the idle timer when focus leaves.
    dock.addEventListener('focusin', () => {
      if (hideTimer !== null) {
        clearTimeout(hideTimer);
        hideTimer = null;
      }
      showDock();
    });
    dock.addEventListener('focusout', () => {
      // focusout runs before the new focus target is set, so defer one
      // microtask to let activeElement settle before deciding.
      setTimeout(() => {
        if (!isFocusInsideDock()) resetHideTimer();
      }, 0);
    });

    window.addEventListener('scroll', queuedHandleScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileDockAutoHide);
  } else {
    initMobileDockAutoHide();
  }
</script>
