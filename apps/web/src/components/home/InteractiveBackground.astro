---
/**
 * InteractiveBackground — Starry particle canvas and cursor-following dot grid.
 *
 * Re-engineered from https://slyth.at/:
 * 1. Background Star Canvas: Ambient drifting, twinkling starry particles.
 * 2. Radial Ambient Light: Follows the cursor with a smooth radial gradient.
 * 3. Dot Grid Matrix: 24px dot grid masked by a cursor-centered circle so dots
 *    glow into visibility only around the pointer.
 *
 * Lightweight, zero-dependency, battery-safe (pauses when tab is hidden or
 * reduced motion is preferred), positioned fixed at z-index: -1 behind all content.
 */
---

<div class="entei-interactive-bg" aria-hidden="true">
  <canvas id="entei-star-canvas"></canvas>
  <div class="entei-bg-radial" data-mouse></div>
  <div class="entei-bg-dots" data-mouse></div>
</div>

<style>
  .entei-interactive-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /* When native mpv video is playing, hide the interactive layer so it never paints over the video hole */
  :global(html.entei-native-video) .entei-interactive-bg {
    display: none !important;
  }

  #entei-star-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .entei-bg-radial {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      620px circle at var(--mx, 50%) var(--my, 18%),
      oklch(100% 0 0deg / 0.05),
      transparent 60%
    );
  }

  .entei-bg-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      oklch(100% 0 0deg / 0.22) 1px,
      transparent 1.5px
    );
    background-size: var(--entei-space-24) var(--entei-space-24);
    mask-image: radial-gradient(
      300px circle at var(--mx, 50%) var(--my, 18%),
      oklch(0% 0 0deg),
      transparent 72%
    );
    -webkit-mask-image: radial-gradient(
      300px circle at var(--mx, 50%) var(--my, 18%),
      oklch(0% 0 0deg),
      transparent 72%
    );
  }
</style>

<script>
  (() => {
    // 1. Pointer Tracking (RAF throttled CSS variable updates)
    const mouseEls = Array.from(document.querySelectorAll<HTMLElement>('[data-mouse]'));
    let ptrRaf = 0;
    let targetX = window.innerWidth * 0.5;
    let targetY = window.innerHeight * 0.18;

    const onPointer = (e: PointerEvent) => {
      targetX = e.clientX;
      targetY = e.clientY;
      if (ptrRaf) return;
      ptrRaf = requestAnimationFrame(() => {
        ptrRaf = 0;
        const xStr = targetX + 'px';
        const yStr = targetY + 'px';
        for (const el of mouseEls) {
          el.style.setProperty('--mx', xStr);
          el.style.setProperty('--my', yStr);
        }
      });
    };

    window.addEventListener('pointermove', onPointer, { passive: true });

    // 2. Star Particle Canvas Animation
    const canvas = document.getElementById('entei-star-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    interface Star {
      x: number;
      y: number;
      r: number;
      vx: number;
      vy: number;
      ph: number;
      tw: number;
      white: boolean;
    }

    let w = 0;
    let h = 0;
    let dpr = 1;
    let stars: Star[] = [];

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    const draw = (t: number, dt: number) => {
      ctx.clearRect(0, 0, w, h);
      const accent = 'oklch(85.99% 0.071 282.16deg)'; // var(--entei-text-secondary)
      const white = 'oklch(100% 0 0deg)';

      for (const p of stars) {
        if (dt > 0) {
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          if (p.y < -10) p.y = h + 10;
          if (p.y > h + 10) p.y = -10;
          if (p.x < -10) p.x = w + 10;
          if (p.x > w + 10) p.x = -10;
        }

        const a = 0.15 + 0.35 * Math.abs(Math.sin(t * p.tw + p.ph));
        const color = p.white ? white : accent;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.globalAlpha = a;
        ctx.fillStyle = color;
        ctx.fill();
      }

      ctx.globalAlpha = 1;
    };

    let reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const resize = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = canvas.clientWidth || window.innerWidth || 900;
      h = canvas.clientHeight || window.innerHeight || 700;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Re-populate stars based on viewport width
      const count = Math.max(30, Math.min(65, Math.round(w / 24)));
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: rand(0.6, 1.4),
          vx: rand(-10, 10),
          vy: rand(-25, -6),
          ph: Math.random() * Math.PI * 2,
          tw: rand(0.6, 1.4),
          white: Math.random() < 0.5,
        });
      }

      if (reducedMotion) {
        draw(0, 0);
      }
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });

    let isVisible = document.visibilityState === 'visible';
    let animId = 0;
    let lastTime = performance.now();

    document.addEventListener('visibilitychange', () => {
      isVisible = document.visibilityState === 'visible';
      if (isVisible && !reducedMotion && !animId) {
        lastTime = performance.now();
        animId = requestAnimationFrame(loop);
      }
    });

    const loop = (now: number) => {
      if (!isVisible) {
        animId = 0;
        return;
      }
      const dt = Math.min(0.1, (now - lastTime) / 1000);
      lastTime = now;
      draw(now / 1000, dt);
      animId = requestAnimationFrame(loop);
    };

    if (reducedMotion) {
      draw(0, 0); // Render static frame
    } else {
      animId = requestAnimationFrame(loop);
    }
  })();
</script>
