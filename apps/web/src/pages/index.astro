---
/**
 * Entei Home — the single canonical Home route at `/`.
 * PHASE0.md Section 5: only `/` is the formal Home. No `/ja/`, `/en/`.
 *
 * Static HTML is Indonesian (PHASE0.md 5.129). The locale switcher module
 * script (loaded by BaseLayout) applies the saved locale after first paint.
 *
 * Content order (docs/FREENET_SOCIAL_TIMELINE.md phase 1):
 * 1. Skip link (in BaseLayout)
 * 2. Top Bar (in BaseLayout)
 * 3. Immersion timeline (FeedComposer + TimelineFeed island) — the only
 *    Home content. The former hero (HubIdentity + DestinationDock),
 *    Roadmap, ThanksTo and LocalFirstNote sections were removed.
 *
 * No Footer: the timeline is a scrolling feed, so a footer would only add
 * a dead block after the last post.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import TimelineFeed from '@components/home/TimelineFeed';
import '@styles/timeline.css';
---

<BaseLayout locale="id" path="/">
  <TimelineFeed client:load />
</BaseLayout>

<style>
  /*
   * The shared 32px top / 64px (desktop) bottom padding from BaseLayout + global.css leaves dead space above and below the feed.
   * Zero both on desktop so the timeline starts right under the Top Bar; on
   * mobile still clear the fixed dock so it never covers the last post's
   * actions. The `#entei-main` prefix outranks the single-class rule in
   * global.css.
   */
  :global(#entei-main .entei-main-inner) {
    padding-block: 0;
  }

  @media (max-width: 767px) {
    :global(#entei-main .entei-main-inner) {
      padding-block: 0 calc(var(--entei-space-24) + var(--entei-dock-height));
    }
  }
</style>
