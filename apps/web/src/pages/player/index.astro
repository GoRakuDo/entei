 * Player Page — `/player/`
 *
 * P1: Local-only vertical slice.
 * - Uses PlayerLayout (no desktop grid, full-width).
 * - React client-only island for browser-only Player.
 * - noindex (PHASE0.md 5.119, 15.388).
 */
import PlayerLayout from '@layouts/PlayerLayout.astro';
import PlayerApp from '@/components/player/PlayerApp';
---

<PlayerLayout locale="id" path="/player/" noindex={true}>
