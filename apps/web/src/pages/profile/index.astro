---
/**
 * Local device profile page — `/profile/`.
 *
 * The profile is local-only and the React island owns browser storage and the
 * IndexedDB-backed Tracker dashboard. Profile is a desktop-pill destination
 * (excluded from the mobile dock); TrackerDashboard lives in the
 * immersion-stats tab.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import '@styles/player.css';
import '@styles/profile.css';
import ProfileDashboard from '@/components/player/ProfileDashboard';
---

<BaseLayout locale="id" path="/profile/" noindex={true} showChrome={true}>
  <ProfileDashboard client:only="react" />
</BaseLayout>
