---
/**
 * Modules management page — `/modules/`.
 *
 * MODULE_ARCHITECTURE.md §5: lists the official core modules (yt-dlp,
 * Torrent, Yomitan) with enable switches persisted in `entei.modules.v1`,
 * plus a placeholder import entry for future community modules.
 *
 * Static HTML ships the Indonesian copy (PHASE0.md 5.129); the React island
 * follows the in-app language switcher via `entei:locale-change`.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import '@styles/modules.css';
import { ModulesDashboard } from '@/components/modules/ModulesDashboard';
import { getDictionary } from '@i18n/index';

const dictionary = getDictionary('id');
---

<BaseLayout
  locale="id"
  path="/modules/"
  title="Modul — Entei"
  description={dictionary.modulesPage.description}
  noindex={true}
  showChrome={true}
>
  <ModulesDashboard client:only="react" dict={dictionary.modulesPage} />
</BaseLayout>
