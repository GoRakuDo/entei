---
/**
 * Legacy Modules route redirect.
 *
 * Module management now lives under the settings page's Modules group
 * (`/settings/?group=module`). Keep this static, noindex page for old
 * bookmarks and direct links (same pattern as /tracker/ → /profile/).
 */
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content="0;url=/settings/?group=module" />
    <link rel="canonical" href="/settings/?group=module" />
    <title>Modul → Pengaturan</title>
  </head>
  <body>
    <p>
      This page has moved to
      <a href="/settings/?group=module">Settings › Modules</a>.
    </p>
    <script is:inline>
      window.location.replace('/settings/?group=module');
    </script>
  </body>
</html>
