{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Entei",
  "version": "0.1.0",
  "identifier": "org.gorakudo.entei",
  "build": {
    "beforeDevCommand": "bun run --cwd=apps/web build",
    "beforeBuildCommand": "bun run --cwd=apps/web build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Entei",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "dragDropEnabled": true,
        "transparent": true,
        "minWidth": 360,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,FluentScrollbar,OverlayScrollbar --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
