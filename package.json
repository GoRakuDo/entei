{
  "name": "entei",
  "version": "0.0.1",
  "private": true,
  "description": "Entei — game-hub style home for the GoRakuDo local-first Japanese learning toolkit. Phase 0 home foundation.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd=apps/web dev",
    "fetch-members": "bun members-supporter/fetch-members.mjs",
    "prebuild": "bun run fetch-members",
    "build": "bun run --cwd=apps/web build",
    "preview": "bun run --cwd=apps/web preview",
    "check": "bun run --cwd=apps/web check",
    "test": "bun run --cwd=apps/web test",
    "tauri": "tauri",
    "format": "prettier --write \"apps/web/**/*.{ts,astro,css,md}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,astro,css,md}\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.31.0"
  }
}
